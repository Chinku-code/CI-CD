promote-image-pre-prod:
  stage: deploy
  image: registry.dev.sbiepay.sbi:8443/library/podman:latest
  variables:
    SOURCE_REGISTRY: "registry.dev.sbiepay.sbi:8443/library"
    IMAGE_NAME: "$CI_PROJECT_NAME"
  script:
    - echo "Pulling image from SIT registry"
    - echo "Image: ${SOURCE_REGISTRY}/${IMAGE_NAME}:${VERSION}"

    - podman login -u $IMAGE_REGISTRY_USERNAME -p $IMAGE_REGISTRY_PASS registry.dev.sbiepay.sbi:8443 --tls-verify=false
    - podman login -u $PREPROD_REGISTRY_USERNAME -p $PREPROD_REGISTRY_PASSWORD \
        epaynonprod-registry-quay-quay-enterprise.apps.preprod.epay.sbi --tls-verify=false

    - podman pull ${SOURCE_REGISTRY}/${IMAGE_NAME}:${VERSION} --tls-verify=false
    - podman tag  ${SOURCE_REGISTRY}/${IMAGE_NAME}:${VERSION} \
                  ${PREPROD_IMAGE_REGISTRY}/${IMAGE_NAME}:${VERSION}
    - podman push ${PREPROD_IMAGE_REGISTRY}/${IMAGE_NAME}:${VERSION} --tls-verify=false

  rules:
    - if: '$CI_COMMIT_BRANCH =~ /^release\/.*$/'
      when: manual
