dockerbuild:
  stage: dockerbuild
  image: registry.dev.sbiepay.sbi:8443/library/podman:latest
  needs:
    - build
  script:
    - echo "=== Docker Build Started ==="
    - echo "ENV=$ENV"
    - echo "IMAGE=${IMAGE_REGISTRY}/${CHART_NAME}:${VERSION}"

    # Login to source registry
    - podman login -u $CI_USERNAME -p $CI_JOB_TOKEN registry.dev.sbiepay.sbi:8443 --tls-verify=false

    # Build
    - podman build -t ${IMAGE_REGISTRY}/${CHART_NAME}:${VERSION} .

    # Push
    - podman push ${IMAGE_REGISTRY}/${CHART_NAME}:${VERSION} --tls-verify=false

    - echo "=== Docker Build Completed ==="

  rules:
    - if: '$CI_COMMIT_BRANCH == "develop"'
      variables:
        ENV: dev
        IMAGE_REGISTRY: $DEV_IMAGE_REGISTRY

    - if: '$CI_COMMIT_BRANCH =~ /^release\/.*$/'
      variables:
        ENV: sit
        IMAGE_REGISTRY: $SIT_IMAGE_REGISTRY
