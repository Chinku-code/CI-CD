    #     IMAGE_REGISTRY_PASS: $PROD_REGISTRY_PASSWORD
    #     IMAGE_NAME: "fe/${CHART_NAME}"
    - if: '$CI_COMMIT_BRANCH =~ /^release\/.*$/'
      when: always
      allow_failure: true
      variables:
        ENV: nonprod # Default for release branch is SIT
        IMAGE_REGISTRY: ${SIT_IMAGE_REGISTRY}
        IMAGE_NAME: "${CHART_NAME}"
    - if: '$CI_COMMIT_BRANCH =~ /^release\/.*$/'
      when: always
      allow_failure: true
      variables:
        ENV: nonprod # Default for release branch is PERF
        IMAGE_REGISTRY: ${PERF_IMAGE_REGISTRY}
        IMAGE_NAME: "${CHART_NAME}"

# --- DEPLOY JOBS ---
.trigger_cd_job_base: &trigger_cd_job_base
  stage: trigger_cd
  needs:
    - dockerbuild
  trigger:
    project: epay/devops/deployment
    branch: main
    strategy: depend
    forward:
      pipeline_variables: true
      yaml_variables: true
  when: manual

deploy-dev:
  <<: *trigger_cd_job_base
  variables:
    ENV: dev
    SERVICE_NAME: $CI_PROJECT_NAME
  rules:
    - if: '$CI_COMMIT_BRANCH == "develop"'

