include:
  - project: 'epay/devops/ci-templates'
    ref: feature/CIfrontend
    file: 'ci/sast/sast.yml'

  - project: 'epay/devops/ci-templates'
    ref: main
    file: 'ci/sast/fortify.sast.yml'

  - project: 'epay/devops/ci-templates'
    ref: feature/CIfrontend
    file: 'ci/release/version.yml'

  - project: 'epay/devops/ci-templates'
    ref: feature/CIfrontend
    file: 'ci/release/release.yml'

  - project: 'epay/devops/ci-templates'
    ref: feature/CIfrontend
    file: 'ci/build/podman.container.yml'

  - project: 'epay/devops/ci-templates'
    ref: feature/CIfrontend
    file: 'ci/deploy/deployment.yml'


# ---------------- STAGES ----------------
stages:
  - build
  - test
  - sast
  - hp-fortify
  - release
  - dockerbuild
  - deploy


# ---------------- GLOBAL VARIABLES ----------------
variables:
  CHART_NAME: "$CI_PROJECT_NAME"
  VERSION: "$CI_COMMIT_SHORT_SHA"

  DEV_IMAGE_REGISTRY: "registry.dev.sbiepay.sbi:8443/ubi9"
  SIT_IMAGE_REGISTRY: "registry.dev.sbiepay.sbi:8443/library"
  UAT_IMAGE_REGISTRY: "registry.dev.sbiepay.sbi:8443/library"

  PERF_IMAGE_REGISTRY: "epaynonprod-registry-quay-quay-enterprise.apps.preprod.epay.sbi/fe"
  PREPROD_IMAGE_REGISTRY: "epaynonprod-registry-quay-quay-enterprise.apps.preprod.epay.sbi/fe"

  PROD_IMAGE_REGISTRY: "registry.prod.epay.sbi:8443/fe"

  PODMAN_TLS_VERIFY: "false"
  GIT_STRATEGY: clone


# ---------------- BUILD ----------------
.build:
  stage: build
  image: registry.dev.sbiepay.sbi:8443/ubi9/reactjs_npm:20241113
  script:
    - npm config set proxy http://serverswg.sbi.co.in:80
    - npm config set https-proxy http://serverswg.sbi.co.in:9090
    - npm cache clean --force
    - npm ci || npm install
    - npm run build
  artifacts:
    paths:
      - dist/
    expire_in: 1 week
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_COMMIT_BRANCH =~ /^(develop|release\/.*)$/'

build:
  extends: .build


# ---------------- DUMMY TEST STAGE (TO FIX SAST ERROR) ----------------
test:
  stage: test
  script:
    - echo "No tests configured"
  rules:
    - when: never


# ---------------- DOCKER BUILD (SINGLE BUILD) ----------------
dockerbuild:
  stage: dockerbuild
  image: registry.dev.sbiepay.sbi:8443/library/podman:latest
  script:
    - echo "Building image $IMAGE_REGISTRY/$CHART_NAME:$VERSION"
    - podman build -t $CHART_NAME:$VERSION .
    - podman tag $CHART_NAME:$VERSION $IMAGE_REGISTRY/$CHART_NAME:$VERSION
    - podman login -u $IMAGE_REGISTRY_USERNAME -p $IMAGE_REGISTRY_PASS $IMAGE_REGISTRY
    - podman push $IMAGE_REGISTRY/$CHART_NAME:$VERSION
  rules:
    - if: '$CI_COMMIT_BRANCH == "develop"'
      variables:
        IMAGE_REGISTRY: $DEV_IMAGE_REGISTRY
        IMAGE_REGISTRY_USERNAME: $DEV_REGISTRY_USERNAME
        IMAGE_REGISTRY_PASS: $DEV_REGISTRY_PASSWORD

    - if: '$CI_COMMIT_BRANCH =~ /^release\/.*$/'
      variables:
        IMAGE_REGISTRY: $SIT_IMAGE_REGISTRY
        IMAGE_REGISTRY_USERNAME: $SIT_REGISTRY_USERNAME
        IMAGE_REGISTRY_PASS: $SIT_REGISTRY_PASSWORD


# ---------------- PROMOTE TO PRE-PROD ----------------
promote-image-pre-prod:
  stage: deploy
  image: registry.dev.sbiepay.sbi:8443/library/podman:latest
  script:
    - podman login -u $SIT_REGISTRY_USERNAME -p $SIT_REGISTRY_PASSWORD $SIT_IMAGE_REGISTRY
    - podman login -u $PREPROD_REGISTRY_USERNAME -p $PREPROD_REGISTRY_PASSWORD $PREPROD_IMAGE_REGISTRY
    - podman pull $SIT_IMAGE_REGISTRY/$CHART_NAME:$VERSION
    - podman tag $SIT_IMAGE_REGISTRY/$CHART_NAME:$VERSION $PREPROD_IMAGE_REGISTRY/$CHART_NAME:$VERSION
    - podman push $PREPROD_IMAGE_REGISTRY/$CHART_NAME:$VERSION
  rules:
    - if: '$CI_COMMIT_BRANCH =~ /^release\/.*$/'
      when: manual


# ---------------- DEPLOY JOBS ----------------
deploy-sit:
  stage: deploy
  needs: ["dockerbuild"]
  trigger:
    project: epay/devops/deployment
    branch: main
    strategy: depend
  variables:
    ENV: sit
  when: manual

deploy-uat:
  stage: deploy
  needs: ["dockerbuild"]
  trigger:
    project: epay/devops/deployment
    branch: main
    strategy: depend
  variables:
    ENV: uat
  when: manual

deploy-perf:
  stage: deploy
  needs: ["dockerbuild"]
  trigger:
    project: epay/devops/deployment
    branch: main
    strategy: depend
  variables:
    ENV: perf
  when: manual

deploy-pre-prod:
  stage: deploy
  needs:
    - dockerbuild
    - promote-image-pre-prod
  trigger:
    project: epay/devops/deployment
    branch: main
    strategy: depend
  variables:
    ENV: preprod
  when: manual
